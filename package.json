{
  "name": "mybackend",
  "version": "1.0.0",
  "description": "An implementation of a backend server using NodeJS, Express, TypeScript, MongoDB, and Redis.",
  "license": "ISC",
  "author": "Abhigyan Prakash Singh",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist/",
    "build": "npm run clean && tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/app.js",
    "dev": "tsx --watch --env-file=.env src/app.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "redis": "^5.7.0",
    "ulid": "^3.0.1",
    "winston": "^3.17.0",
    "zod": "^4.0.14"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "git add"
    ]
  }
}
